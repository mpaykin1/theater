{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikhail-paykin-theatretherapy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/afisha/*",
      "/kurs/*",
      "/individual/*",
      "/about/*",
      "/druzya-tbilisi/*",
      "/tvorcheskie-znakomstva-tbilisi/*",
      "/chem-zanyatsya-tbilisi/*",
      "/privacy/*"
    ]
  }
}
